{
  "all": {
    "sourceCodeDir": "app/frontend",
    "watchAdditionalPaths": [],
    "ssrEntrypoint": "~/entrypoints/ssr.ts"
  },
  "development": {
    "autoBuild": true,
    "skipProxy": true,
    "publicOutputDir": "vite-dev",
    "port": 3036
  },
  "test": {
    "autoBuild": true,
    "publicOutputDir": "vite-test",
    "port": 3037
  },
  "production": {
    "ssrBuildEnabled": true
  },
  "staging": {
    "ssrBuildEnabled": true
  }
}
