= form_with model: purchase_item,
    class: "flex flex-col w-full gap-2 no_events",
    id: dom_id(purchase_item, :tracking_number),
    url: purchase_item_tracking_number_path(purchase_item),
    method: :patch do |form|

  = form.text_field :tracking_number,
      value: purchase_item.tracking_number,
      class: "border rounded px-2 py-1 text-sm w-full",
      placeholder: "Enter tracking number",
      autofocus: true,
      autocomplete: "off"

  - if purchase_item.errors.any?
    p.text_error.text-xs.no_events
      = purchase_item.errors.full_messages.join(", ")

  .flex.gap-1.justify-center
    button.btn_rounded.btn_xs.btn_green type="submit" title="Save"
      i.icn ✅
      | Save
    = link_to purchase_item_path(purchase_item),
        class: "btn_red btn_xs btn_rounded",
        title: "Cancel" do
      i.icn ❎
      | Exit
