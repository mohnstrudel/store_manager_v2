{
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest",
    "lint": "oxlint app/frontend --quiet && node tools/source-policy/frontend/cli.js --css-only",
    "lint:source-policy": "node tools/source-policy/frontend/cli.js",
    "lint:perf": "oxlint app/frontend -D perf",
    "lint:fix": "oxlint app/frontend --fix",
    "lint:fix:all": "oxlint app/frontend --fix-dangerously",
    "format": "oxfmt app/frontend .oxlintrc.json .oxfmtrc.json config/vite.json package.json tsconfig.json vite.config.ts",
    "format:check": "oxfmt --check app/frontend .oxlintrc.json .oxfmtrc.json config/vite.json package.json tsconfig.json vite.config.ts",
    "typecheck": "oxlint app/frontend",
    "build": "vite build",
    "heroku-postbuild": "pnpm build",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@dnd-kit/helpers": "^0.5.1",
    "@dnd-kit/react": "^0.5.1",
    "@floating-ui/react": "^0.27.20",
    "@heroicons/react": "^2.2.0",
    "@inertiajs/react": "^3.9.1",
    "@js-from-routes/client": "^1.0.4",
    "@rails/activestorage": "^8.1.400",
    "@tiptap/extension-link": "^3.32.0",
    "@tiptap/extension-text-align": "^3.32.0",
    "@tiptap/extension-underline": "^3.32.0",
    "@tiptap/react": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-select": "^5.10.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@inertiajs/vite": "^3.9.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/rails__activestorage": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint-plugin-testing-library": "^7.16.2",
    "jsdom": "^30.1.3",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "oxlint-tsgolint": "^7.0.2004",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-ruby": "^5.2.6",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": "24.x"
  },
  "packageManager": "pnpm@12.4.1"
}
