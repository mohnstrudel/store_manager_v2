#!/usr/bin/env sh

export RUBOCOP_CACHE_ROOT="${RUBOCOP_CACHE_ROOT:-tmp/rubocop_cache}"
TEST_LOG_DIR="${TEST_LOG_DIR:-tmp/test-logs}"
TEST_LOG_TAIL="${TEST_LOG_TAIL:-80}"

failed_commands=""
background_labels=""

mkdir -p "$TEST_LOG_DIR"

log_file_for() {
  printf "%s/%s.log" "$TEST_LOG_DIR" "$1"
}

status_file_for() {
  printf "%s/%s.status" "$TEST_LOG_DIR" "$1"
}

print_failure_log() {
  label="$1"
  log_file="$(log_file_for "$label")"

  printf "\n--- %s output ---\n" "$label"
  if [ "$TEST_LOG_TAIL" = "all" ]; then
    cat "$log_file"
  else
    tail -n "$TEST_LOG_TAIL" "$log_file"
  fi
}

record_result() {
  label="$1"
  status="$2"

  if [ "$status" -eq 0 ]; then
    printf "    passed\n"
    return 0
  fi

  printf "    failed\n"
  failed_commands="${failed_commands}
- $label"
  print_failure_log "$label"
}

run() {
  label="$1"
  shift
  log_file="$(log_file_for "$label")"

  printf "\n==> %s\n" "$label"
  "$@" >"$log_file" 2>&1
  record_result "$label" "$?"
}

run_in_background() {
  label="$1"
  shift
  log_file="$(log_file_for "$label")"
  status_file="$(status_file_for "$label")"

  printf "\n==> %s (started)\n" "$label"
  (
    "$@" >"$log_file" 2>&1
    printf "%s\n" "$?" >"$status_file"
  ) &
  printf "%s\n" "$!" >"$TEST_LOG_DIR/$label.pid"
  background_labels="$background_labels $label"
}

wait_for_background_commands() {
  for label in $background_labels; do
    pid="$(cat "$TEST_LOG_DIR/$label.pid")"
    wait "$pid"
    status="$(cat "$(status_file_for "$label")")"
    printf "\n==> %s\n" "$label"
    record_result "$label" "$status"
  done
}

run backend-rubocop bin/bundle exec rubocop --format quiet --force-exclusion --cache-root "$RUBOCOP_CACHE_ROOT"
run backend-rspec bin/rspec --format progress --no-profile

run_in_background frontend-lint pnpm exec oxlint app/frontend --quiet --format unix
run_in_background frontend-lint-perf pnpm exec oxlint app/frontend -D perf --quiet --format unix
run_in_background frontend-format pnpm exec oxfmt --list-different app/frontend .oxlintrc.json .oxfmtrc.json config/vite.json package.json tsconfig.json vite.config.ts
run_in_background frontend-typecheck pnpm exec tsc --noEmit --pretty false
run_in_background frontend-vitest pnpm exec vitest run --silent=passed-only
wait_for_background_commands

if [ -n "$failed_commands" ]; then
  printf "\nFailed commands:%s\n" "$failed_commands"
  exit 1
fi
