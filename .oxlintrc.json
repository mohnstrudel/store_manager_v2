{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "style": "off",
    "nursery": "off",
    "pedantic": "off",
    "perf": "error",
    "restriction": "off"
  },
  "env": {
    "browser": true,
    "vitest": true
  },
  "options": {
    "typeAware": true,
    "typeCheck": true
  },
  "ignorePatterns": ["app/frontend/api/**/*"],
  "plugins": [
    "eslint",
    "typescript",
    "unicorn",
    "oxc",
    "react",
    "react-perf",
    "import",
    "vitest",
    "jsx-a11y"
  ],
  "jsPlugins": ["./tools/source-policy/frontend/oxlint-plugin.js"],
  "settings": {
    "react": {
      "version": "19.2.6"
    }
  },
  "overrides": [
    {
      "files": ["**/*.test.tsx", "**/*.test.ts"],
      "rules": {
        "react-perf/jsx-no-new-object-as-prop": "off",
        "react-perf/jsx-no-new-array-as-prop": "off",
        "react-perf/jsx-no-new-function-as-prop": "off",
        "react-perf/jsx-no-jsx-as-prop": "off",
        "typescript/unbound-method": "off",
        "vitest/no-focused-tests": "error",
        "vitest/no-disabled-tests": "warn",
        "vitest/no-identical-title": "error",
        "vitest/no-conditional-expect": "error",
        "vitest/no-standalone-expect": "error",
        "vitest/valid-expect": "error",
        "vitest/no-duplicate-hooks": "error",
        "vitest/prefer-hooks-on-top": "warn",
        "vitest/max-expects": ["warn", { "max": 4 }]
      }
    },
    {
      "files": ["app/frontend/test/mocks/**"],
      "rules": {
        "react-perf/jsx-no-new-object-as-prop": "off",
        "react-perf/jsx-no-new-array-as-prop": "off",
        "react-perf/jsx-no-new-function-as-prop": "off",
        "react-perf/jsx-no-jsx-as-prop": "off"
      }
    }
  ],
  "rules": {
    "import/no-unassigned-import": ["warn", { "allow": ["**/*.css"] }],
    "eslint/no-unused-vars": [
      "error",
      {
        "argsIgnorePattern": "^_",
        "caughtErrorsIgnorePattern": "^_",
        "varsIgnorePattern": "^_"
      }
    ],
    "eslint/no-underscore-dangle": "off",
    "react/react-in-jsx-scope": "off",
    "react/rules-of-hooks": "error",
    "react/hooks": "error",
    "react/exhaustive-deps": "error",
    "react/exhaustive-effect-dependencies": "error",
    "react/set-state-in-effect": "error",
    "react/memo-dependencies": "error",
    "react/refs": "error",
    "react/immutability": "error",
    "react/no-unstable-nested-components": "error",
    "react/capitalized-calls": "error",
    "react/jsx-no-comment-textnodes": "error",
    "react/jsx-no-script-url": "error",
    "react/no-namespace": "error",
    "react/style-prop-object": "error",
    "source-policy/ordering": "error",
    "source-policy/no-prose-comments": "error"
  }
}
